# ================= CDOW — CS2 CASES & DROP & OPEN & WIN =================
# MADE BY VOLVIX — copy this file to .env and fill your values.

# --- Server ---
PORT=3000
# Public URL of the site (used in bot links & Telegram widget)
SITE_URL=http://localhost:3000

# --- Telegram bot (required for real login) ---
# 1) Open @BotFather in Telegram → /newbot → name it "CDOW" 
# 2) Paste the token here:
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT @ (e.g. CDOWBot)
BOT_USERNAME=
# Channel for big-win announcements: add the bot as admin to your channel,
# then put the channel id here (@mychannel or -100xxxxxxxxxx)
TELEGRAM_CHANNEL_ID=

# --- Payments ---
# sandbox = deposits auto-approve after 4s (testing) | live = admin approves manually
PAYMENTS_MODE=sandbox
# Your crypto deposit addresses (shown to users):
CRYPTO_BTC=
CRYPTO_ETH=
CRYPTO_USDT=
# PayPal.me or business checkout link:
PAYPAL_LINK=

# --- Admin panel (http://localhost:3000/admin.html) ---
ADMIN_KEY=change-me-to-a-long-random-string

# --- Dev-only: enables POST /api/auth/dev {name} quick login for testing ---
CDOW_DEV=0
